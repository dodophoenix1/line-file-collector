PORT=3000
PUBLIC_ORIGIN=https://your-public-domain.example

# Required dashboard/admin secrets. Keep these server-side only.
DASHBOARD_PIN=replace-with-a-private-pin
ADMIN_PASSWORD=replace-with-a-long-unique-password
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Safety limits
MAX_FILE_BYTES=209715200

LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
GOOGLE_DRIVE_FOLDER_ID=replace-with-google-drive-folder-id

# Optional MySQL configuration
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
